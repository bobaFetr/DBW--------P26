{
  "name": "paralyze-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "dotnet run --project \"Back End/MyApi/MyApi.csproj\" --launch-profile http",
    "dev:frontend": "next dev",
    "build": "next build && node scripts/externalize-inline-scripts.cjs && node scripts/remove-disabled-admin-output.cjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "dotnet test \"Back End/MyApi.Tests/MyApi.Tests.csproj\" /m:1",
    "test:frontend": "node --test tests/frontend/*.test.cjs"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "eslint": "^9.24.0",
    "eslint-config-next": "15.5.23"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.0"
  }
}
