# Public pages use data/temporaryContent.js unless switched to "backend".
NEXT_PUBLIC_CONTENT_SOURCE=temporary

# Local API address used when testing the backend-powered frontend and admin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001

# Local development only: show API-published admin content alongside the
# temporary JavaScript content without changing the public content source.
NEXT_PUBLIC_LOCAL_ADMIN_OVERLAY=true

# Keep false/unset in deployed environments. Set true only in .env.local.
ENABLE_LOCAL_ADMIN=true

